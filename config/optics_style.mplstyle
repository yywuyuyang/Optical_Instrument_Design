figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.05

font.family: sans-serif
font.sans-serif: SimHei, Arial, DejaVu Sans
font.size: 11
axes.titlesize: 14
axes.labelsize: 12
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10

axes.linewidth: 1.2
lines.linewidth: 2.0
lines.markersize: 6
xtick.major.width: 1.0
ytick.major.width: 1.0
xtick.minor.width: 0.5
ytick.minor.width: 0.5

axes.grid: True
grid.alpha: 0.3
grid.linewidth: 0.5

figure.figsize: 10, 6
figure.constrained_layout.use: True

axes.unicode_minus: False
